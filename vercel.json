{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth?action=login" },
    { "source": "/api/auth/logout", "destination": "/api/auth?action=logout" },
    { "source": "/api/imdb/search", "destination": "/api/media?provider=imdb&action=search" },
    { "source": "/api/imdb/details", "destination": "/api/media?provider=imdb&action=details" },
    { "source": "/api/gemini/media-lookup", "destination": "/api/media?provider=gemini&action=lookup" },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
